Subject: [PATCH 2/2] =?UTF-8?q?fix(34491):=20=E6=96=B0=E8=A6=8F=E3=83=96?=
 =?UTF-8?q?=E3=83=A9=E3=83=B3=E3=83=81push=E3=81=AEpre-push=E9=96=A2?=
 =?UTF-8?q?=E6=89=80=E3=82=92origin/main=E5=9F=BA=E6=BA=96=E3=81=AB?=
 =?UTF-8?q?=E4=BF=AE=E6=AD=A3?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

新規ブランチをpushすると、鬼監督/関所が空tree基準でdiffを取るため
origin/mainの既存全ファイルが「新規追加」として丸ごと再スキャンされ、
過去に合格済みのページまで誤ってFAILし、pushが止まっていた
（実測：716/717等の既存share/check/*.htmlが新規違反として検出・数百件スキャンで数分ハング）。
origin/mainのtreeを基準にして本当の差分だけを見るよう修正。

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 .githooks/pre-push | 27 +++++++++++++++++++++++----
 1 file changed, 23 insertions(+), 4 deletions(-)

diff --git a/.githooks/pre-push b/.githooks/pre-push
index 65c7836be..f35214811 100755
--- a/.githooks/pre-push
+++ b/.githooks/pre-push
@@ -21,6 +21,24 @@ ZERO="0000000000000000000000000000000000000000"
 FAIL=0
 CHECKED=0
 
+# 34491番で発見・修正（2026-10-06）：新規ブランチpush（remote_sha=ZERO）のとき、
+# 従来は空tree基準でdiffを取っていたため、origin/mainに既にある全ファイルが
+# 「新規追加」として丸ごと再スキャンされ、過去に合格済みの既存ページまで
+# 鬼監督/関所に引っかかって押せなくなっていた（oni_baseline.jsonの「借金」免除が
+# 効かない抜け道）。新規ブランチのときは空treeではなくorigin/mainのtree（取得できれば）
+# を基準にし、本当に今回の差分だけを見るようにする。origin/mainが無い環境では
+# 従来どおり空tree（安全側＝厳しめ）にフォールバックする。
+empty_tree() { git hash-object -t tree /dev/null; }
+new_branch_base() {
+  local t
+  t="$(git rev-parse -q --verify 'origin/main^{tree}' 2>/dev/null)"
+  if [ -n "$t" ]; then
+    echo "$t"
+  else
+    empty_tree
+  fi
+}
+
 # pushのref一覧はstdinから1回しか読めない。関所を2段かけるので先に受け取っておく。
 REFS="$(cat)"
 
@@ -42,7 +60,7 @@ ONI_FILES=""
 while read -r local_ref local_sha remote_ref remote_sha; do
   [ "$local_sha" = "$ZERO" ] && continue
   if [ "$remote_sha" = "$ZERO" ]; then
-    base="$(git hash-object -t tree /dev/null)"
+    base="$(new_branch_base)"
   else
     base="$remote_sha"
   fi
@@ -87,8 +105,9 @@ while read -r local_ref local_sha remote_ref remote_sha; do
     continue
   fi
   if [ "$remote_sha" = "$ZERO" ]; then
-    # 新規ブランチ：空ツリーとの差分で判定
-    base="$(git hash-object -t tree /dev/null)"
+    # 新規ブランチ：origin/mainとの差分で判定（34491番で修正。空ツリー基準だと
+    # origin/mainの既存全ファイルが「新規」として丸ごと再スキャンされてしまう）
+    base="$(new_branch_base)"
   else
     base="$remote_sha"
   fi
@@ -145,7 +164,7 @@ REFSEOF
 while read -r local_ref local_sha remote_ref remote_sha; do
   [ "$local_sha" = "$ZERO" ] && continue
   if [ "$remote_sha" = "$ZERO" ]; then
-    base="$(git hash-object -t tree /dev/null)"
+    base="$(new_branch_base)"
   else
     base="$remote_sha"
   fi
-- 
