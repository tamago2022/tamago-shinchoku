{
  "$comment": "1154号：止まれない関所。公式 https://code.claude.com/docs/en/hooks の書き方をそのまま使っている（command型・${CLAUDE_PROJECT_DIR}・timeout）。Stop/SubagentStop は exit code 2 で終了を拒否する。",
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PROJECT_DIR}/tools/stop_kanmon/stop_hook.mjs", "timeout": 60 } ] }
    ],
    "SubagentStop": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node ${CLAUDE_PROJECT_DIR}/tools/stop_kanmon/stop_hook.mjs", "timeout": 60 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PROJECT_DIR}/tools/stop_kanmon/prompt_gate.mjs", "timeout": 15 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PROJECT_DIR}/tools/stop_kanmon/session_end.mjs", "timeout": 15 } ] }
    ]
  }
}
